# Copy to .env and edit. Everything not marked required is optional.

# --- Core ---
# Set automatically by docker-compose. Only needed when running without Docker.
DATABASE_URL=postgres://command:command@localhost:5432/command
# Password for the bundled Postgres container (docker-compose). Change it.
POSTGRES_PASSWORD=change-me
# Public URL of your install. Must be https:// in production for PWA install and push.
APP_URL=https://command.example.com
# Server timezone (the team timezone is set separately in the setup wizard).
TZ=UTC

# --- Features ---
# Set to false to hide the leaderboard everywhere.
LEADERBOARD_ENABLED=true

# --- Google sign-in (optional, recommended) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email (optional). Enables email verification, password reset links, decision emails. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Command <no-reply@example.com>

# --- Google Calendar ---
# off | ics | api
GOOGLE_CALENDAR_MODE=off
# ics mode: secret ICS address of your calendar
GOOGLE_CALENDAR_ICS_URL=
# api mode: calendar id and service account key (JSON on one line)
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Setup ---
# Optional override for the one-time setup token. If unset, one is generated and printed to the app logs.
SETUP_TOKEN=
